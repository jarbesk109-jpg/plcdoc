                      </documentation>
                    </variable>
                    <variable name="bAlarm">
                      <type>
                        <BOOL />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Báo lỗi</xhtml>
                      </documentation>
                    </variable>
                  </outputVars>
                  <localVars>
                    <variable name="tonFault">
                      <type>
                        <derived name="TON" />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Lọc nhiễu tín hiệu lỗi</xhtml>
                      </documentation>
                    </variable>
                  </localVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">tonFault(IN := bFault, PT := T#500MS);
bAlarm := tonFault.Q;
bRun := (bStart OR bRun) AND bStop AND bInterlock AND NOT bAlarm;</xhtml>
                  </ST>
                </body>
                <addData>
