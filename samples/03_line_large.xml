                    <ObjectId>34f8f1b6-4d79-4e40-8a91-6c7ef9f44836</ObjectId>
                  </data>
                </addData>
              </pou>
            </data>
            <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
              <pou name="FC_Scale" pouType="function">
                <interface>
                  <returnType>
                    <REAL />
                  </returnType>
                  <inputVars>
                    <variable name="iRaw">
                      <type>
                        <INT />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Giá trị analog thô</xhtml>
                      </documentation>
                    </variable>
                    <variable name="rMin">
                      <type>
                        <REAL />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Giá trị kỹ thuật nhỏ nhất</xhtml>
                      </documentation>
                    </variable>
                    <variable name="rMax">
                      <type>
                        <REAL />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Giá trị kỹ thuật lớn nhất</xhtml>
                      </documentation>
                    </variable>
                  </inputVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">FC_Scale := rMin + (INT_TO_REAL(iRaw) / 27648.0) * (rMax - rMin);</xhtml>
                  </ST>
                </body>
