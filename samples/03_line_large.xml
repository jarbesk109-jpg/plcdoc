          <addData>
            <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
              <pou name="PLC_PRG" pouType="program">
                <interface>
                  <localVars>
                    <variable name="fbConv1">
                      <type>
                        <derived name="FB_Motor" />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Băng tải 1</xhtml>
                      </documentation>
                    </variable>
                    <variable name="fbConv2">
                      <type>
                        <derived name="FB_Motor" />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Băng tải 2</xhtml>
                      </documentation>
                    </variable>
                    <variable name="fbConv3">
                      <type>
                        <derived name="FB_Motor" />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Băng tải 3</xhtml>
                      </documentation>
                    </variable>
                    <variable name="bLineReady">
                      <type>
                        <BOOL />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Dây chuyền sẵn sàng</xhtml>
                      </documentation>
                    </variable>
                  </localVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">bLineReady := bEStopOK AND bDoorClosed AND bAutoMode;

fbConv1(bStart := bStart1, bStop := bStop1, bFault := bFault1, bInterlock := bLineReady, bRun =&gt; bMotor1);
fbConv2(bStart := bStart2, bStop := bStop2, bFault := bFault2, bInterlock := bLineReady AND bMotor1, bRun =&gt; bMotor2);
fbConv3(bStart := bStart3, bStop := bStop3, bFault := bFault3, bInterlock := bLineReady AND bMotor2, bRun =&gt; bMotor3);

rTankLevel := FC_Scale(iRaw := iTankLevelRaw, rMin := 0.0, rMax := 100.0);
rTemp      := FC_Scale(iRaw := iTempRaw, rMin := -20.0, rMax := 150.0);

bLampAlarm := fbConv1.bAlarm OR fbConv2.bAlarm OR fbConv3.bAlarm OR NOT bEStopOK;
iSpeedRef  := REAL_TO_INT(rTankLevel * 276.48);

PRG_Alarm();</xhtml>
                  </ST>
                </body>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
                    <ObjectId>9b1a9a2b-8ba9-403a-b424-c25da00f499c</ObjectId>
                  </data>
                </addData>
              </pou>
            </data>
