                      </type>
                    </variable>
                    <variable name="rSpeed">
                      <type>
                        <REAL />
                      </type>
                    </variable>
                  </localVars>
                </interface>
                <actions>
                  <action name="A_Reset">
                    <body>
                      <ST>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml">stData.eState := E_DriveState.IDLE;
stData.rSpeedSet := 0.0;</xhtml>
                      </ST>
                    </body>
                    <addData>
                      <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
                        <ObjectId>dcdab03c-ecff-4353-8a0d-02eccc418395</ObjectId>
                      </data>
                    </addData>
                  </action>
                </actions>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">xRunning := xEnable AND (stData.eState = E_DriveState.RUNNING);</xhtml>
                  </ST>
                </body>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
                    <Method name="M_Start" ObjectId="83aeae5d-a9ca-42fb-92de-e4cb743d3453">
                      <interface>
                        <returnType>
                          <BOOL />
                        </returnType>
                        <inputVars>
                          <variable name="rTarget">
                            <type>
                              <REAL />
                            </type>
                          </variable>
                        </inputVars>
                        <localVars>
                          <variable name="xOk">
                            <type>
                              <BOOL />
                            </type>
                          </variable>
                        </localVars>
                      </interface>
                      <body>
                        <ST>
                          <xhtml xmlns="http://www.w3.org/1999/xhtml">xOk := rTarget &gt;= 0.0;
IF xOk THEN
    stData.rSpeedSet := rTarget;
    stData.eState := E_DriveState.RUNNING;
END_IF
M_Start := xOk;</xhtml>
                        </ST>
                      </body>
                      <addData />
                    </Method>
                  </data>
