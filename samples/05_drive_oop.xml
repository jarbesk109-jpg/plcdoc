            <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
              <pou name="PLC_PRG" pouType="program">
                <interface>
                  <localVars>
                    <variable name="fbDrive">
                      <type>
                        <derived name="FB_Drive" />
                      </type>
                    </variable>
                    <variable name="xStart">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="xOk">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="rActual">
                      <type>
                        <REAL />
                      </type>
                    </variable>
                  </localVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">fbDrive(xEnable := TRUE);
IF xStart THEN
    xOk := fbDrive.M_Start(rTarget := 1500.0);
    xStart := FALSE;
END_IF
fbDrive.P_Speed := 1200.0;
rActual := fbDrive.P_Speed;
IF NOT fbDrive.xRunning THEN
    fbDrive.A_Reset();
END_IF</xhtml>
                  </ST>
                </body>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
                    <ObjectId>85aa22c4-4b4b-432a-831f-e9e068b52572</ObjectId>
